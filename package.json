{
	"name": "clc",
	"private": true,
	"packageManager": "pnpm@10.33.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @clc/web dev --host",
		"build": "pnpm --filter @clc/web build",
		"build:cf": "pnpm --filter @clc/web build:cf",
		"preview": "pnpm --filter @clc/web preview",
		"preview:cf": "wrangler pages dev apps/web/dist",
		"test": "pnpm -r test",
		"format": "biome format .",
		"lint": "biome lint .",
		"check": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@tanstack/cli": "^0.68.0",
		"@ticktockbent/charlotte": "^0.6.3",
		"typescript": "^6.0.2",
		"wrangler": "^3.99.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"puppeteer",
			"workerd"
		]
	}
}
