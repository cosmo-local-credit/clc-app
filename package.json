{
  "name": "clc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @clc/web dev --host",
    "dev:admin": "pnpm --filter @clc/admin dev --host",
    "build": "pnpm --filter @clc/web build",
    "build:admin": "pnpm --filter @clc/admin build",
    "check:bundle:admin": "pnpm --filter @clc/admin check:bundle",
    "build:cf": "pnpm --filter @clc/web build:cf",
    "preview": "pnpm --filter @clc/web preview",
    "preview:cf": "wrangler pages dev apps/web/dist",
    "test": "pnpm -r test",
    "i18n:extract": "lingui extract",
    "test:e2e": "pnpm --filter @clc/web test:e2e",
    "test:e2e:bs": "pnpm --filter @clc/web test:e2e:bs",
    "format": "vp fmt --fix",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "check": "vp check",
    "knip": "knip",
    "knip:cycles": "knip --cycles",
    "knip:production": "knip --production",
    "knip:ci": "knip --reporter github-actions",
    "knip:report": "knip --reporter markdown",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@lingui/babel-plugin-lingui-macro": "6.2.0",
    "@lingui/cli": "6.2.0",
    "@lingui/vite-plugin": "6.2.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/cli": "^0.68.0",
    "@ticktockbent/charlotte": "^0.6.3",
    "@types/babel__core": "^7.20.5",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "knip": "^6.29.0",
    "typescript": "^6.0.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.100.0"
  },
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "pnpm@11.7.0"
}
