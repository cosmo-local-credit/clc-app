VITE_API_URL="http://localhost:5003"

# Development-only operator session. Mint one with `make gen-user-token` in the
# clc-core repo and paste it here; it lets the console read authenticated
# endpoints before a real operator sign-in exists.
VITE_ADMIN_API_TOKEN=""

# Development only. A production build fails while this is true.
VITE_ADMIN_STUB_AUTH="true"

# Map tiles on the account detail screen. Without it the map is not rendered at
# all — the rest of the screen is unaffected.
VITE_MAPTILER_KEY=""

# Image upload service, shared with apps/web. Uploads go straight from the browser
# to this host, carrying the session token in an Authorization header.
VITE_STORAGE_URL="http://localhost:5003"
