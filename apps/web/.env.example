VITE_WALLETCONNECT_PROJECT_ID=
VITE_API_URL=https://api.example.com
VITE_WEBPUSH_BASE_URL=http://localhost:8787
VITE_MAPTILER_KEY=
# Image upload service. Uploads go straight from the browser to this host.
VITE_STORAGE_URL=https://storage.example.com
VITE_RELAYER_URL=https://api.example.com/api/v2/relayer
# Optional. Unset, viem uses the chain's own default endpoint.
VITE_PUBLIC_RPC_URL=https://r1-gnosis.grassecon.org
# Optional comma-separated public fallbacks. The chain default is appended last.
VITE_PUBLIC_RPC_FALLBACK_URLS=https://gnosis-rpc.publicnode.com
# Optional. Unset, the Calibur deployed on VITE_CHAIN_ID is used.
VITE_CALIBUR_ADDRESS=
# 42220 Celo, 44787 Alfajores, 100 Gnosis.
VITE_CHAIN_ID=100
VITE_RELYING_PARTY_ID=
VITE_RELYING_PARTY_NAME=CLC
VITE_PAPER_WALLET_ORIGIN=https://cosmolocal.credit
VITE_DEFAULT_COUNTRY=KE
# Optional. The Grassroots Economics v3 name gateway — reverse resolution turns a
# recipient address into the name the address book stores. Names are keyed by
# address, not by chain, so a Gnosis build may point at the same host.
VITE_ENS_RESOLVER_URL=https://resolver.v3.grassecon.net/api/v1/resolve
# Optional. Phone-number lookup on the same stack.
VITE_PHONE_LOOKUP_URL=https://kvviseru.v3.grassecon.net/api/v1/lookup/address
