{
  "extends": "../../tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["e2e", "playwright.config.ts"],
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@clc/api/*": ["../../packages/api/src/*"],
      "@clc/core/*": ["../../packages/core/src/*"],
      "@clc/i18n/*": ["../../packages/i18n/src/*"]
    }
  }
}
